# Entity: search

main: kit: entity: search: {

  alias: field: {}

  fields: [
    {
      format: "double"
      name: "ceo_compensation"
      req: false
      short: "Total CEO compensation"
      type: "`$NUMBER`"
    }
    {
      name: "ceo_name"
      req: false
      short: "Name of the CEO"
      type: "`$STRING`"
    }
    {
      name: "company_name"
      req: false
      short: "Name of the company"
      type: "`$STRING`"
    }
    {
      name: "employees"
      req: false
      short: "Number of employees"
      type: "`$INTEGER`"
    }
    {
      name: "headquarters"
      req: false
      short: "Company headquarters location"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the company"
      type: "`$STRING`"
    }
    {
      name: "industry"
      req: false
      short: "Industry sector"
      type: "`$STRING`"
    }
    {
      name: "performance_metrics"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "double"
      name: "revenue"
      req: false
      short: "Annual revenue"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "search"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "field"
                orig: "field"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/search"
          segments: [
            {
              lit: "search"
            }
          ]
          select: {
            exist: [
              "field"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
